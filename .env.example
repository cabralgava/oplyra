# Oplyra — variáveis do ambiente LOCAL (I-01). Sem segredos reais.
# Portas próprias: web 3100, Supabase 544xx. Outro projeto nesta máquina ocupa
# 3000 e 543xx; a Oplyra não compartilha infraestrutura com ele.
# Os valores abaixo são exemplos; os reais de desenvolvimento saem de `supabase start`.

OPLYRA_ENV=local

# Proteção contra apontar o ambiente local para um serviço remoto.
# A aplicação e os testes falham na inicialização se a URL não for local e esta flag não for true.
OPLYRA_ALLOW_REMOTE=false

# Supabase local (valores impressos por `supabase status`)
SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key local>
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Conexões PostgreSQL (papéis definidos após o EXP-01)
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@127.0.0.1:54422/postgres
DATABASE_URL_APP=postgresql://oplyra_web_login:<senha local>@127.0.0.1:54422/postgres

# Verificação de sessão
SUPABASE_JWT_ISSUER=http://127.0.0.1:54421/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54421/auth/v1/.well-known/jwks.json

# Credencial privilegiada, restrita ao ops-cli. Nunca em web ou worker.
OPS_ADMIN_CREDENTIAL=<somente local>

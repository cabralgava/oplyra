# Configurar no site Netlify oplyra-develop (Builds + Functions quando aplicável).
# Não copiar para o .env do desenvolvimento local. SITE_ID, SITE_NAME e URL são reservadas do provedor.
OPLYRA_ENV=develop
SUPABASE_PROJECT_REF=eqpvjydnqbbawpkeizys
SUPABASE_URL=https://eqpvjydnqbbawpkeizys.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://eqpvjydnqbbawpkeizys.supabase.co
NEXT_PUBLIC_APP_URL=https://oplyra-develop.netlify.app
OPLYRA_NETLIFY_SITE_ID=45056cd1-6732-40b3-b341-8b9fecca8345
# Obter a chave publicável da branch develop, não da main.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<chave-publicavel-de-develop>
# Segredo apenas servidor; Functions e Builds se a composição o exigir na avaliação do build.
# Senha própria deste login, nunca postgres/service_role; não disponibilizar a outros sites/previews.
DATABASE_URL_APP=postgresql://oplyra_web_login.eqpvjydnqbbawpkeizys:<senha-do-login-web-de-develop>@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# NÃO incluir DATABASE_URL_MIGRATIONS, segredos de produção ou providers pagos neste site.
# Exemplo não é configuração aplicada na Netlify; web precisa usar carregarConfigDevelop na composição.

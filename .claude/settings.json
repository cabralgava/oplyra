{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Glob|Grep|Write|Edit|MultiEdit|NotebookEdit|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-local-first-guard.mjs\" --policy=autonomous",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:db)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:harness)",
      "Bash(pnpm scan:secrets)",
      "Bash(pnpm build)",
      "Bash(pnpm verificar)",
      "Bash(pnpm db:start)",
      "Bash(pnpm db:stop)",
      "Bash(pnpm db:status)",
      "Bash(pnpm db:reset)",
      "Bash(pnpm db:roles)",
      "Bash(pnpm harness:tools)",
      "Bash(pnpm test *)",
      "Bash(pnpm git:branch)",
      "Bash(pnpm git:stage *)",
      "Bash(pnpm git:commit --message-file *)",
      "Bash(pnpm git:push)",
      "Bash(pnpm gh:pr-create *)",
      "Bash(pnpm gh:pr-update *)",
      "Bash(pnpm gh:ci-status)",
      "Bash(pnpm gh:ci-status --wait *)",
      "Bash(pnpm gh:ci-log --check *)",
      "Bash(pnpm gh:ci-diagnose --diagnosis-file *)",
      "Bash(pnpm gh:doctor)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree)",
      "Bash(git ls-tree *)",
      "Bash(git cat-file)",
      "Bash(git cat-file *)",
      "Bash(git --no-pager log *)",
      "Bash(git --no-pager diff *)",
      "Bash(git --no-pager show *)",
      "Bash(rg *)",
      "Bash(sed -n *)",
      "Bash(shasum *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(find *)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_navigate_back",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_network_request",
      "mcp__playwright__browser_tabs",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_find",
      "mcp__playwright__browser_click",
      "mcp__playwright__browser_hover",
      "mcp__playwright__browser_type",
      "mcp__playwright__browser_fill_form",
      "mcp__playwright__browser_press_key",
      "mcp__playwright__browser_select_option",
      "mcp__playwright__browser_handle_dialog",
      "mcp__playwright__browser_emulate_media"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(git --git-dir*)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm add *)",
      "Bash(pnpm install*)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(corepack *)",
      "Bash(gh *)",
      "Bash(supabase *)",
      "Bash(rm *)",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_evaluate",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_drag",
      "mcp__playwright__browser_drop",
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./.npmrc)",
      "Read(./**/.npmrc)",
      "Read(./.netrc)",
      "Read(./**/.netrc)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs"
    ]
  }
}

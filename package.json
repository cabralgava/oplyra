{
  "name": "oplyra",
  "version": "0.1.0-i01",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:start": "scripts/db-guard.sh start",
    "db:stop": "scripts/db-guard.sh stop",
    "db:status": "scripts/db-guard.sh status",
    "db:reset": "scripts/db-guard.sh reset",
    "db:test": "supabase test db",
    "exp01": "pnpm --filter @oplyra/exp-01 run all",
    "db:roles": "scripts/local-db-roles.sh",
    "test": "vitest run",
    "test:db": "supabase test db --local",
    "typecheck": "pnpm --parallel --filter @oplyra/core --filter @oplyra/infra --filter @oplyra/testing exec tsc -p tsconfig.json --noEmit",
    "build": "pnpm --filter @oplyra/web build",
    "scan:secrets": "scripts/scan-secrets.sh",
    "verificar": "pnpm typecheck && pnpm test && pnpm test:db && pnpm test:e2e && pnpm scan:secrets && pnpm build",
    "test:e2e": "playwright test",
    "test:harness": "node --test scripts/claude-local-first-guard.test.mjs scripts/claude-launch.test.mjs scripts/claude-delivery.test.mjs",
    "release:reproduce": "node tools/contract-release/release.mjs reproduce",
    "release:build": "node tools/contract-release/release.mjs build",
    "release:gates": "node tools/contract-release/release.mjs gates",
    "git:branch": "node scripts/claude-git.mjs branch",
    "git:stage": "node scripts/claude-git.mjs stage",
    "git:commit": "node scripts/claude-git.mjs commit",
    "git:push": "node scripts/claude-git.mjs push",
    "gh:pr-create": "node scripts/claude-git.mjs pr-create",
    "gh:pr-update": "node scripts/claude-git.mjs pr-update",
    "gh:ci-status": "node scripts/claude-git.mjs ci-status",
    "gh:ci-log": "node scripts/claude-git.mjs ci-log",
    "gh:ci-diagnose": "node scripts/claude-git.mjs ci-diagnose",
    "gh:doctor": "node scripts/claude-git.mjs doctor",
    "harness:tools": "node scripts/claude-launch.mjs --versions",
    "harness:mcp": "node scripts/claude-launch.mjs --mcp-list",
    "claude:local": "node scripts/claude-launch.mjs",
    "harness:install": "corepack pnpm --dir tools/developer-harness install --frozen-lockfile",
    "claude:maintenance": "node scripts/claude-launch.mjs --maintenance",
    "runner:start": "node scripts/codex-supervise.mjs",
    "runner:status": "node scripts/claude-runner.mjs status",
    "runner:stop": "node scripts/claude-runner.mjs stop",
    "runner:once": "node scripts/claude-runner.mjs start"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}

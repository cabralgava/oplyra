{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/runtime/outbox-dispatcher/settlement-output/1.0",
  "title": "Outbox Dispatcher Settlement — Output",
  "description": "Estado persistido depois de validar tenant, attempt e fencing token.",
  "type": "object",
  "required": [
    "tenantId",
    "eventTransactionId",
    "consumerAgent",
    "status",
    "attempt",
    "settledAt"
  ],
  "properties": {
    "tenantId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/tenantId"
    },
    "eventTransactionId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
    },
    "consumerAgent": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/agentKey"
    },
    "status": {
      "type": "string",
      "enum": [
        "dispatched",
        "failed",
        "dead_lettered",
        "duplicate"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "settledAt": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
    },
    "nextAvailableAt": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
    }
  },
  "additionalProperties": false
}

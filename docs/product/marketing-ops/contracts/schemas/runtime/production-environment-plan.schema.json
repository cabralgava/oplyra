{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/runtime/production-environment-plan/1.0",
  "title": "Oplyra Staging and Production Environment Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planVersion", "authorization", "environments", "isolation", "destinations", "database", "releaseSequence", "activationGates", "pendingDecisions"],
  "properties": {
    "planVersion": { "const": "1.0" },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planningApproved", "provisioningAuthorized", "deploymentAuthorized", "realDataAuthorized", "runtimeActivationAuthorized", "explicitApprovalRequiredForCreation"],
      "properties": {
        "planningApproved": { "const": true },
        "provisioningAuthorized": { "const": false },
        "deploymentAuthorized": { "const": false },
        "realDataAuthorized": { "const": false },
        "runtimeActivationAuthorized": { "const": false },
        "explicitApprovalRequiredForCreation": { "const": true }
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "staging", "production"],
      "properties": {
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "remote", "dataPolicy", "integrationPolicy"],
          "properties": {
            "state": { "const": "existing" },
            "remote": { "const": false },
            "dataPolicy": { "const": "synthetic_only" },
            "integrationPolicy": { "const": "fake_or_replay_by_default" }
          }
        },
        "staging": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "productionEquivalent", "dataPolicy", "decisionDependency", "requiredBeforeRuntimeActivation"],
          "properties": {
            "state": { "const": "planned_not_created" },
            "productionEquivalent": { "const": true },
            "dataPolicy": { "const": "synthetic_only" },
            "decisionDependency": { "const": "DP-28b" },
            "requiredBeforeRuntimeActivation": { "const": true }
          }
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "dataPolicy", "internalVerificationTenantsRequired", "runtimeStartsDisabled"],
          "properties": {
            "state": { "const": "planned_not_created" },
            "dataPolicy": { "const": "no_real_data_before_readiness_approval" },
            "internalVerificationTenantsRequired": { "const": true },
            "runtimeStartsDisabled": { "const": true }
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["separateDatabaseProjects", "separateCredentials", "separateSecrets", "separateQueues", "crossEnvironmentDataCopyAllowed", "productionFallbackFromPreviewAllowed"],
      "properties": {
        "separateDatabaseProjects": { "const": true },
        "separateCredentials": { "const": true },
        "separateSecrets": { "const": true },
        "separateQueues": { "const": true },
        "crossEnvironmentDataCopyAllowed": { "const": false },
        "productionFallbackFromPreviewAllowed": { "const": false }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "proposedProvider", "proposedRegion", "status", "decisionDependency"],
        "properties": {
          "component": { "enum": ["database", "web", "worker", "observability", "transactional_email", "source_control_ci"] },
          "proposedProvider": { "type": ["string", "null"], "minLength": 1 },
          "proposedRegion": { "type": ["string", "null"], "minLength": 1 },
          "status": { "enum": ["proposed_conditioned", "pending_selection"] },
          "decisionDependency": { "type": "string", "minLength": 1 }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrationsOnly", "manualProductionChangesAllowed", "expandContractRequired", "rlsRequired", "directTableAccessForWorkers", "backupCapabilityMustBeVerified", "restoreExerciseRequiredBeforeRealData", "pitrAssumedAvailable"],
      "properties": {
        "migrationsOnly": { "const": true },
        "manualProductionChangesAllowed": { "const": false },
        "expandContractRequired": { "const": true },
        "rlsRequired": { "const": true },
        "directTableAccessForWorkers": { "const": false },
        "backupCapabilityMustBeVerified": { "const": true },
        "restoreExerciseRequiredBeforeRealData": { "const": true },
        "pitrAssumedAvailable": { "const": false }
      }
    },
    "releaseSequence": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "enum": ["approve_destinations_and_budget", "authorize_resource_creation", "create_isolated_staging", "apply_staging_migrations", "run_staging_security_and_E2-09", "approve_production_creation", "create_production_disabled", "apply_production_migrations", "run_non_destructive_readiness", "separate_runtime_activation_change"] }
    },
    "activationGates": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": { "enum": ["EXP-03_passed", "EXP-04_passed_before_real_data", "DP-28b_resolved", "provider_and_region_approved", "budget_approved", "secrets_and_identities_ready", "RLS_negative_isolation_passed", "backup_restore_verified", "E2-09_staging_passed", "rollback_drill_passed", "observability_and_alerting_ready", "explicit_runtime_activation_approved"] }
    },
    "pendingDecisions": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "enum": ["DP-05a", "DP-05b", "DP-06a", "DP-06b", "DP-07a", "DP-07b", "DP-08a", "DP-14b", "DP-15b", "DP-28b"] }
    }
  }
}

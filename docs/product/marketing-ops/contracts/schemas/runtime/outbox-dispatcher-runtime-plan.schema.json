{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/runtime/outbox-dispatcher-runtime-plan/1.0",
  "title": "Oplyra Outbox Dispatcher Polling and Composition Root Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planVersion", "activation", "topology", "polling", "transport", "scheduler", "compositionRoot", "shutdown", "observability", "scaling"],
  "properties": {
    "planVersion": { "const": "1.0" },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "explicitChangeRequired", "killSwitchRequired", "checkBeforeEachClaim"],
      "properties": {
        "enabled": { "const": false },
        "explicitChangeRequired": { "const": true },
        "killSwitchRequired": { "const": true },
        "checkBeforeEachClaim": { "const": true }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerRuntime", "workerCountPerQueue", "processingMode", "tenantScheduling", "crossTenantBatchAllowed", "dispatcherIdentity"],
      "properties": {
        "workerRuntime": { "enum": ["node_long_running"] },
        "workerCountPerQueue": { "const": 1 },
        "processingMode": { "enum": ["sequential_single_cycle"] },
        "tenantScheduling": { "enum": ["round_robin"] },
        "crossTenantBatchAllowed": { "const": false },
        "dispatcherIdentity": { "enum": ["unique_per_process"] }
      }
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultBatchSize", "maximumBatchSize", "leaseDurationSeconds", "idleIntervalMilliseconds", "failureIntervalMilliseconds", "emptyCycleConsumesAttempt"],
      "properties": {
        "defaultBatchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
        "maximumBatchSize": { "const": 500 },
        "leaseDurationSeconds": { "const": 120 },
        "idleIntervalMilliseconds": { "const": 1000 },
        "failureIntervalMilliseconds": { "const": 5000 },
        "emptyCycleConsumesAttempt": { "const": false }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobQueue", "eventOutboxSourceOfTruth", "eventOutboxClaimBoundary", "scheduler", "pgmqIsEventSourceOfTruth", "pgCronMayDeliverEvents"],
      "properties": {
        "jobQueue": { "const": "pgmq" },
        "eventOutboxSourceOfTruth": { "const": "content.event_outbox" },
        "eventOutboxClaimBoundary": { "const": "app.claim_outbox_events" },
        "scheduler": { "const": "pg_cron" },
        "pgmqIsEventSourceOfTruth": { "const": false },
        "pgCronMayDeliverEvents": { "const": false }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "role", "overlapAllowed", "misfirePolicy", "occurrenceIdempotencyScope"],
      "properties": {
        "timezone": { "const": "UTC" },
        "role": { "const": "materialize_and_enqueue_only" },
        "overlapAllowed": { "const": false },
        "misfirePolicy": { "const": "catch_up_once" },
        "occurrenceIdempotencyScope": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["tenantId", "scheduleRef", "occurrenceAt"] }
        }
      }
    },
    "compositionRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypointType", "requiredDependencies", "consumerResolution", "configurationSource", "startupWithActivationDisabled"],
      "properties": {
        "entrypointType": { "const": "dedicated_worker_process" },
        "requiredDependencies": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["activationGate", "tenantSchedule", "outboxDispatcher", "consumerRegistry", "deliveryFailurePolicy", "deadLetterPublisher", "clock", "telemetry"]
          }
        },
        "consumerResolution": { "const": "registered_event_key_and_consumer_agent" },
        "configurationSource": { "const": "validated_runtime_configuration" },
        "startupWithActivationDisabled": { "const": "healthy_idle_no_claim" }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopClaimsFirst", "inFlightPolicy", "unsettledRecovery", "drainTimeoutSeconds"],
      "properties": {
        "stopClaimsFirst": { "const": true },
        "inFlightPolicy": { "const": "attempt_settlement_without_redelivery" },
        "unsettledRecovery": { "const": "lease_expiry_and_fencing" },
        "drainTimeoutSeconds": { "const": 30 }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredMetrics", "tenantLabelsAllowed", "payloadContentInMetricsAllowed"],
      "properties": {
        "requiredMetrics": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["queue_lag", "claim_count", "empty_cycle_count", "delivery_count", "retry_count", "dead_letter_count", "settlement_failure_count", "cycle_duration"] }
        },
        "tenantLabelsAllowed": { "const": false },
        "payloadContentInMetricsAllowed": { "const": false }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automaticScaleOutAllowed", "workerOrBatchIncreaseRequires", "stagingRevalidationRequired"],
      "properties": {
        "automaticScaleOutAllowed": { "const": false },
        "workerOrBatchIncreaseRequires": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["explicit_change", "E2-01_retest", "E2-09_retest"] }
        },
        "stagingRevalidationRequired": { "const": true }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/copywriting/create-copy-variants/output/1.0",
  "title": "Create Copy Variants — Output",
  "description": "Payload de result da action canônica create_copy_variants. Evidence, limitations e next permanecem nos campos correspondentes do envelope transacional.",
  "type": "object",
  "required": [
    "variants"
  ],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/copyVariant"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "copyVariant": {
      "type": "object",
      "required": [
        "id",
        "headline",
        "primaryText",
        "cta"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "role": {
          "type": "string",
          "enum": [
            "reference",
            "challenger"
          ]
        },
        "angle": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "headline": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "primaryText": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "cta": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "changedElements": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "constantElements": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "variants": [
        {
          "id": "var_b_copy_01",
          "role": "challenger",
          "angle": "unattributed_revenue",
          "headline": "Quanto da sua aquisição realmente vira pipeline?",
          "primaryText": "Conecte investimento, pipeline e receita sem perder as limitações da atribuição.",
          "cta": "request_demo",
          "changedElements": [
            "angle",
            "headline",
            "primaryText"
          ],
          "constantElements": [
            "offer",
            "cta",
            "format"
          ]
        }
      ]
    }
  ]
}

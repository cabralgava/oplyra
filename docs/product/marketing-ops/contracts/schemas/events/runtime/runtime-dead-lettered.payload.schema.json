{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/events/runtime/runtime-dead-lettered/payload/1.0",
  "title": "runtime.dead_lettered — Payload",
  "description": "Payload versionado para escalonamento de uma entrega terminal em dead-letter. Tenant e trace permanecem no transaction envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deadLetterRef",
    "sourceEventTransactionId",
    "sourceEventKey",
    "consumerAgent",
    "attempt",
    "terminalReason",
    "terminalErrorCode",
    "rootCause",
    "deadLetteredAt",
    "humanEscalationRequired",
    "reprocessing"
  ],
  "properties": {
    "deadLetterRef": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
    },
    "sourceEventTransactionId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
    },
    "sourceEventKey": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/eventKey"
    },
    "consumerAgent": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/agentKey"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "terminalReason": {
      "type": "string",
      "enum": ["retry_exhausted", "non_retryable_failure"]
    },
    "terminalErrorCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "rootCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "deadLetteredAt": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
    },
    "humanEscalationRequired": {
      "const": true
    },
    "reprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automaticAllowed", "authorizationRevalidationRequired", "preservesSourceLink"],
      "properties": {
        "automaticAllowed": { "const": false },
        "authorizationRevalidationRequired": { "const": true },
        "preservesSourceLink": { "const": true }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}

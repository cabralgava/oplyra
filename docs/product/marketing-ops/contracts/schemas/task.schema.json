{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/core/task/1.0",
  "title": "Oplyra Task",
  "description": "Contrato canônico para uma unidade de trabalho do runtime agentic da Oplyra.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "tenantId",
    "type",
    "title",
    "status",
    "priority",
    "owner",
    "assignedAgent",
    "acceptanceCriteria",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "schemaVersion": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/schemaVersion"
    },
    "tenantId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/tenantId"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "status": {
      "$ref": "#/$defs/taskStatus"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ]
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "assignedAgent": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/agentKey"
    },
    "initiativeId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
    },
    "experimentId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
    },
    "workflowId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
    },
    "parentTaskId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^task_[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "contextPackageId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ctx_[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskDependency"
      },
      "default": []
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/approvalRef"
      },
      "default": []
    },
    "blockedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/blocker"
      },
      "default": []
    },
    "outputRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
      },
      "default": []
    },
    "risk": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/riskLevel"
    },
    "sideEffect": {
      "type": "boolean",
      "default": false
    },
    "requiresApproval": {
      "type": "boolean",
      "default": false
    },
    "requiresIdempotency": {
      "type": "boolean",
      "default": false
    },
    "idempotencyKey": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 255
    },
    "dueAt": {
      "oneOf": [
        {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
    },
    "updatedAt": {
      "oneOf": [
        {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "startedAt": {
      "oneOf": [
        {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAt": {
      "oneOf": [
        {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "oneOf": [
        {
          "$ref": "#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "waiting_dependency"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "dependencies": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "waiting_approval"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "requiresApproval": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requiresApproval": {
            "const": true
          }
        },
        "required": [
          "requiresApproval"
        ]
      },
      "then": {
        "properties": {
          "approvals": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requiresIdempotency": {
            "const": true
          }
        },
        "required": [
          "requiresIdempotency"
        ]
      },
      "then": {
        "required": [
          "idempotencyKey"
        ],
        "properties": {
          "idempotencyKey": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockedBy": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completedAt"
        ],
        "properties": {
          "completedAt": {
            "type": "string"
          },
          "acceptanceCriteria": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "failure"
        ],
        "properties": {
          "failure": {
            "$ref": "#/$defs/failure"
          }
        }
      }
    }
  ],
  "$defs": {
    "taskStatus": {
      "type": "string",
      "enum": [
        "backlog",
        "ready",
        "in_progress",
        "waiting_dependency",
        "waiting_approval",
        "blocked",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "team",
            "agent",
            "system"
          ]
        },
        "id": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        }
      }
    },
    "taskDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "type"
      ],
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^task_[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "blocks",
            "requires",
            "related"
          ]
        },
        "requiredStatus": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ready",
            "in_progress",
            "completed",
            "cancelled",
            "failed",
            null
          ]
        }
      }
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ac_[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "waived"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
          },
          "default": []
        },
        "waiverReason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "waived"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "waiverReason"
            ],
            "properties": {
              "waiverReason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "approvalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "scope",
        "status"
      ],
      "properties": {
        "approvalId": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "scope": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected",
            "expired",
            "revoked",
            "stale"
          ]
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "reason": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "ref": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}

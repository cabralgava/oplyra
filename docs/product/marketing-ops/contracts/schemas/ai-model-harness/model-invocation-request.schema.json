{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/ai-model-harness/model-invocation-request/1.0",
  "title": "Oplyra Model Invocation Request",
  "description": "Pedido ao AI Model Harness (CR-026 §8.1). Não seleciona modelo, fornecedor nem parâmetro de amostragem. Invariantes de runtime fora do subconjunto de schema: mensagens até 256 KiB cada e 1 MiB no total em UTF-8; inputModalities contém text; requestedImages obrigatório e >= 1 em rota visual e ausente ou 0 nas demais; declared não pode ficar abaixo da classificação verificada.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocationId",
    "tenantId",
    "workflowKey",
    "agentKey",
    "actionKey",
    "trace",
    "classification",
    "messages",
    "inputModalities"
  ],
  "properties": {
    "invocationId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/invocationId"
    },
    "tenantId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/tenantId"
    },
    "workflowKey": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/workflowKey"
    },
    "agentKey": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/agentKey"
    },
    "actionKey": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/actionKey"
    },
    "trace": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/traceContext"
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "declared"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/classificationSourceRef"
          }
        },
        "declared": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "synthetic",
            "internal",
            "tenant_confidential",
            "personal_data",
            null
          ]
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 262144,
            "pattern": "^(?:[^\\ud800-\\udfff]|[\\ud800-\\udbff][\\udc00-\\udfff])+$"
          }
        }
      }
    },
    "inputModalities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "text",
          "image",
          "audio",
          "video"
        ]
      }
    },
    "inputTokensHint": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/nonNegativeSafeInteger"
    },
    "requestedImages": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/nonNegativeSafeInteger"
    }
  }
}

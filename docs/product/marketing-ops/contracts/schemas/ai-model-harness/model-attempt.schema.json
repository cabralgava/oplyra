{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/ai-model-harness/model-attempt/1.0",
  "title": "Oplyra Model Attempt",
  "description": "Snapshot de uma tentativa do Cost Ledger (CR-027 §4.2) devolvido por app.acquire_model_attempt, app.close_model_attempt e app.reconcile_model_attempt. Não contém fencing token, prompt, resposta nem PII. Invariantes fora do subconjunto de schema: callId = attemptCallId(tenantId, actionKey, invocationId, attempt); fingerprintKeyId é o keyId do requestFingerprint; reserved ⇒ leaseExpiresAt não nulo e closedAt, actualMicroUsd, pendingReason nulos; settled ⇒ actualMicroUsd não nulo; released ⇒ actualMicroUsd = 0; pending_reconciliation ⇒ actualMicroUsd nulo e pendingReason não nulo; reconciled ⇒ actualMicroUsd, pendingReason, reconciledAt e reconciliationEvidenceRef não nulos; fora de reserved, leaseExpiresAt nulo e closedAt não nulo; lease_expired somente por sweep.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenantId",
    "actionKey",
    "invocationId",
    "attempt",
    "callId",
    "workflowKey",
    "agentKey",
    "requestFingerprint",
    "fingerprintKeyId",
    "tenantPeriodId",
    "workflowPeriodId",
    "status",
    "estimateMicroUsd",
    "actualMicroUsd",
    "pendingReason",
    "leaseSeconds",
    "leaseExpiresAt",
    "acquiredAt",
    "closedAt",
    "reconciledAt",
    "reconciliationEvidenceRef"
  ],
  "properties": {
    "tenantId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/tenantId"
    },
    "actionKey": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/actionKey"
    },
    "invocationId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/invocationId"
    },
    "attempt": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/attempt"
    },
    "callId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/attemptCallId"
    },
    "workflowKey": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/workflowKey"
    },
    "agentKey": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/identifierLimits/$defs/agentKey"
    },
    "requestFingerprint": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/requestFingerprint"
    },
    "fingerprintKeyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "tenantPeriodId": {
      "type": "string",
      "pattern": "^bp-[0-9a-f]{32}$"
    },
    "workflowPeriodId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^bp-[0-9a-f]{32}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "reserved",
        "settled",
        "released",
        "pending_reconciliation",
        "reconciled"
      ]
    },
    "estimateMicroUsd": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.1#/$defs/nonNegativeSafeInteger"
    },
    "actualMicroUsd": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pendingReason": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "billing_unknown",
        "provider_response_invalid",
        "adapter_exception",
        "cost_not_computable",
        "lease_expired",
        null
      ]
    },
    "leaseSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 900
    },
    "leaseExpiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "acquiredAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reconciledAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reconciliationEvidenceRef": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    }
  }
}

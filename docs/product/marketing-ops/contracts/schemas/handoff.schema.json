{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oplyra.com/core/handoff/1.0",
  "title": "Oplyra Agent Handoff",
  "description": "Contrato canônico para transferência estruturada de trabalho, contexto e responsabilidade entre agentes Oplyra.",
  "$comment": "Invariantes cross-field como fromAgent != toAgent, tenant consistency entre refs e validade do par de handoff no registry exigem validação de runtime/registry além do JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "tenantId",
    "fromAgent",
    "toAgent",
    "taskId",
    "objective",
    "status",
    "inputRefs",
    "decisionsMade",
    "constraints",
    "openQuestions",
    "expectedOutput",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^handoff_[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "schemaVersion": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/schemaVersion"
    },
    "tenantId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/tenantId"
    },
    "fromAgent": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/agentKey"
    },
    "toAgent": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/agentKey"
    },
    "taskId": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "workflowId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
    },
    "correlationId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
    },
    "causationId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
    },
    "initiativeId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
    },
    "experimentId": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
    },
    "contextPackageId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ctx_[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "accepted",
        "rejected",
        "completed",
        "cancelled",
        "superseded"
      ]
    },
    "inputRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputRef"
      },
      "default": []
    },
    "decisionsMade": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "default": []
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "default": []
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openQuestion"
      },
      "default": []
    },
    "expectedOutput": {
      "$ref": "#/$defs/expectedOutput"
    },
    "requiredContextRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
      },
      "default": []
    },
    "approvalRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
      },
      "default": []
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
      },
      "default": []
    },
    "createdAt": {
      "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
    },
    "acceptedAt": {
      "oneOf": [
        {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedAt": {
      "oneOf": [
        {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "rejection": {
      "oneOf": [
        {
          "$ref": "#/$defs/rejection"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "acceptedAt"
        ],
        "properties": {
          "acceptedAt": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "acceptedAt",
          "completedAt"
        ],
        "properties": {
          "acceptedAt": {
            "type": "string"
          },
          "completedAt": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "rejection"
        ],
        "properties": {
          "rejection": {
            "$ref": "#/$defs/rejection"
          }
        }
      }
    }
  ],
  "$defs": {
    "inputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "type",
        "required"
      ],
      "properties": {
        "ref": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "type": {
          "type": "string",
          "enum": [
            "task",
            "context",
            "initiative",
            "experiment",
            "asset",
            "content",
            "report",
            "campaign",
            "segment",
            "approval",
            "evidence",
            "other"
          ]
        },
        "version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^decision_[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "decision": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "sourceRef": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
        },
        "madeBy": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
        },
        "madeAt": {
          "oneOf": [
            {
              "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "binding": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "severity"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "brand",
            "business",
            "legal",
            "budget",
            "timeline",
            "experiment",
            "channel",
            "approval",
            "permission",
            "technical",
            "other"
          ]
        },
        "description": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "blocking"
          ]
        },
        "ref": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "impact"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^question_[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "question": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "impact": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "blocking"
          ]
        },
        "owner": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
        },
        "resolvableBy": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
        }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "description"
      ],
      "properties": {
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "schemaRef": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
        },
        "qualityGateRef": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nullableNonEmptyString"
        },
        "dueAt": {
          "oneOf": [
            {
              "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "reason": {
          "$ref": "https://schemas.oplyra.com/core/common-definitions/1.0#/$defs/nonEmptyString"
        },
        "retryable": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
